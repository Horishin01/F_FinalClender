# database/config/development.env へコピーして使用する（development.env はGit管理外）。
# 値に空白や # がある場合はダブルクォートで囲む。
POSTGRES_DB=timeledger
POSTGRES_USER=timeledger_app
POSTGRES_PASSWORD=CHANGE_THIS_DEVELOPMENT_DATABASE_PASSWORD

# F5起動では appsettings.Development.Local.json の同じ接続先を使用する。
ConnectionStrings__DefaultConnection="Host=127.0.0.1;Port=55432;Database=timeledger;Username=timeledger_app;Password=CHANGE_THIS_DEVELOPMENT_DATABASE_PASSWORD"
