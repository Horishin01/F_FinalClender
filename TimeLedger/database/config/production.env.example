# database/config/production.env へコピーして所有者だけが読める権限にする（production.env はGit管理外）。
# POSTGRES_* と接続文字列内のDB名・ユーザー・パスワードは必ず一致させる。
POSTGRES_DB=timeledger
POSTGRES_USER=timeledger_app
POSTGRES_PASSWORD=CHANGE_THIS_PRODUCTION_DATABASE_PASSWORD
ConnectionStrings__DefaultConnection="Host=127.0.0.1;Port=5432;Database=timeledger;Username=timeledger_app;Password=CHANGE_THIS_PRODUCTION_DATABASE_PASSWORD"

ASPNETCORE_ENVIRONMENT=Production
AllowedHosts=calendar.example.com
