{
  "__comment": "本番は同一ホストのリバースプロキシでTLS終端する。接続文字列と実ホスト名は環境変数で設定する。",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://127.0.0.1:5016"
      }
    }
  },
  "Security": {
    "RequireHttps": true,
    "TrustedProxyIp": "127.0.0.1"
  },
  "BootstrapAdmin": {
    "Enabled": false
  },
  "AllowedHosts": "__SET_PRODUCTION_HOST__"
}
