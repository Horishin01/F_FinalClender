# TimeLedger本番用Nginx構成。
# __TIMELEDGER_DOMAIN__ を証明書のSANと一致する実ドメインへ置換してから有効化する。
# Kestrelは127.0.0.1:5016のHTTPだけで待ち受け、TLSと証明書はNginxで管理する。

server {
    listen 80;
    listen [::]:80;
    server_name __TIMELEDGER_DOMAIN__;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 308 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name __TIMELEDGER_DOMAIN__;

    ssl_certificate /etc/letsencrypt/live/__TIMELEDGER_DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__TIMELEDGER_DOMAIN__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:TimeLedgerTLS:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=2592000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    location / {
        proxy_pass http://127.0.0.1:5016;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Connection "";
    }
}
